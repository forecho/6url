# Server
HTTP_PORT=8087
GIN_MODE=debug
ENVIRONMENT=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8087
CORS_ALLOWED_ORIGINS=http://localhost:3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=6url
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# Admin API token hashing. Generate with: openssl rand -hex 32
ADMIN_TOKEN_PEPPER=

# Stripe (USD only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LISTING_PRICE_ID=
STRIPE_AD_PRICE_ID=

# Email: unosend or sendflare
EMAIL_PROVIDER=unosend
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_API_BASE_URL=

# Administrator notifications
ADMIN_NOTIFY_CHANNELS=slack
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# ImgAnt assets are uploaded by the local AI. The API stores public identifiers only.
IMGANT_ALLOWED_HOSTS=cdn.imgant.com
IMGANT_ALBUM=6url

# Notification payload encryption. Generate: openssl rand -base64 32
NOTIFICATION_ENCRYPTION_KEY=
