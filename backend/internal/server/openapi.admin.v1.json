{
  "openapi": "3.1.0",
  "info": {
    "title": "6URL Administration API",
    "version": "0.1.0"
  },
  "servers": [
    { "url": "https://api.6url.net" }
  ],
  "components": {
    "securitySchemes": {
      "adminToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "6url scoped token"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      },
      "ManualSiteLocalization": {
        "type": "object",
        "required": ["locale", "name", "tagline", "summary", "description", "seo_title", "seo_description"],
        "properties": {
          "locale": { "type": "string", "enum": ["zh-CN", "en", "ja", "ko"] },
          "name": { "type": "string" },
          "tagline": { "type": "string" },
          "summary": { "type": "string" },
          "description": { "type": "string" },
          "seo_title": { "type": "string" },
          "seo_description": { "type": "string" }
        }
      },
      "ManualSiteRequest": {
        "type": "object",
        "required": ["canonical_url", "slug", "category_id", "localizations"],
        "properties": {
          "canonical_url": { "type": "string", "format": "uri" },
          "slug": { "type": "string" },
          "category_id": { "type": "integer" },
          "logo_asset_id": { "type": ["integer", "null"] },
          "localizations": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/ManualSiteLocalization" }
          }
        }
      },
      "ReviewRequest": {
        "type": "object",
        "properties": { "note": { "type": "string", "maxLength": 500 } }
      },
      "AssetRegisterRequest": {
        "type": "object",
        "required": ["external_id", "storage_key", "public_url", "content_hash", "mime_type", "size_bytes", "width", "height", "album"],
        "properties": {
          "external_id": { "type": "string" },
          "storage_key": { "type": "string" },
          "public_url": { "type": "string", "format": "uri" },
          "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "mime_type": { "type": "string", "pattern": "^image/" },
          "size_bytes": { "type": "integer", "minimum": 1 },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "album": { "type": "string", "const": "6url" }
        }
      }
    }
  },
  "security": [{ "adminToken": [] }],
  "paths": {
    "/admin/v1/openapi.json": {
      "get": {
        "operationId": "getAdminOpenAPI",
        "responses": { "200": { "description": "OpenAPI document" } }
      }
    },
    "/admin/v1/me": {
      "get": {
        "operationId": "getAdminIdentity",
        "responses": { "200": { "description": "Current administrator token" } }
      }
    },
    "/admin/v1/overview": {
      "get": {
        "operationId": "getAdminOverview",
        "responses": { "200": { "description": "Operational counts" } }
      }
    },
    "/admin/v1/categories": {
      "get": {
        "operationId": "listCategories",
        "parameters": [{ "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100 } }],
        "responses": { "200": { "description": "Category list" } }
      }
    },
    "/admin/v1/sites": {
      "get": {
        "operationId": "listSites",
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100 } },
          { "name": "status", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Site list" } }
      }
    },
    "/admin/v1/sites/manual": {
      "post": {
        "operationId": "createManualSite",
        "description": "Creates a draft site and a free editorial placement. It does not create a submission or payment order.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ManualSiteRequest" } } }
        },
        "responses": {
          "201": { "description": "Draft site created" },
          "400": { "description": "Invalid request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "409": { "description": "URL or slug conflict", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/admin/v1/submissions": {
      "get": { "operationId": "listSubmissions", "responses": { "200": { "description": "Listing submission queue" } } }
    },
    "/admin/v1/submissions/{id}/preapprove": {
      "post": { "operationId": "preapproveSubmission", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReviewRequest" } } } }, "responses": { "200": { "description": "Preapproved; paid applications receive an order" }, "409": { "description": "Invalid state or unavailable offer" } } }
    },
    "/admin/v1/submissions/{id}/request-changes": {
      "post": { "operationId": "requestSubmissionChanges", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReviewRequest" } } } }, "responses": { "200": { "description": "Changes requested" } } }
    },
    "/admin/v1/submissions/{id}/reject": {
      "post": { "operationId": "rejectSubmission", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReviewRequest" } } } }, "responses": { "200": { "description": "Submission rejected" } } }
    },
    "/admin/v1/ad-applications": {
      "get": { "operationId": "listAdApplications", "responses": { "200": { "description": "Sponsor advertising application queue" } } }
    },
    "/admin/v1/ad-applications/{id}/preapprove": {
      "post": { "operationId": "preapproveAdApplication", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReviewRequest" } } } }, "responses": { "200": { "description": "Preapproved with a sponsor order" } } }
    },
    "/admin/v1/ad-applications/{id}/request-changes": {
      "post": { "operationId": "requestAdApplicationChanges", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReviewRequest" } } } }, "responses": { "200": { "description": "Changes requested" } } }
    },
    "/admin/v1/ad-applications/{id}/reject": {
      "post": { "operationId": "rejectAdApplication", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReviewRequest" } } } }, "responses": { "200": { "description": "Advertising application rejected" } } }
    },
    "/admin/v1/assets/register": {
      "post": { "operationId": "registerImgAntAsset", "description": "Registers metadata for an image already uploaded by local AI to the ImgAnt 6url album.", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AssetRegisterRequest" } } } }, "responses": { "201": { "description": "Asset registered" } } }
    },
    "/admin/v1/ads/manual": {
      "post": { "operationId": "createManualSponsorAd", "description": "Creates a free administrator-owned draft sponsor ad without an application or payment order.", "responses": { "201": { "description": "Draft sponsor ad created" } } }
    },
    "/admin/v1/ads": {
      "get": { "operationId": "listAds", "responses": { "200": { "description": "Sponsor advertisements" } } }
    },
    "/admin/v1/orders": {
      "get": { "operationId": "listOrders", "responses": { "200": { "description": "Payment orders" } } }
    }
  }
}
