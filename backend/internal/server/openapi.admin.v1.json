{
  "openapi": "3.1.0",
  "info": {
    "title": "6URL Administration API",
    "version": "0.2.0"
  },
  "servers": [
    { "url": "https://api.6url.net" }
  ],
  "components": {
    "securitySchemes": {
      "adminToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "6url scoped token"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      },
      "ManualSiteLocalization": {
        "type": "object",
        "required": ["locale", "name", "tagline", "summary", "description", "seo_title", "seo_description"],
        "properties": {
          "locale": { "type": "string", "enum": ["zh-CN", "en", "ja", "ko"] },
          "name": { "type": "string" },
          "tagline": { "type": "string" },
          "summary": { "type": "string" },
          "description": { "type": "string" },
          "seo_title": { "type": "string" },
          "seo_description": { "type": "string" }
        }
      },
      "ManualSiteRequest": {
        "type": "object",
        "required": ["canonical_url", "slug", "category_id", "localizations"],
        "properties": {
          "canonical_url": { "type": "string", "format": "uri" },
          "slug": { "type": "string" },
          "category_id": { "type": "integer" },
          "logo_asset_id": { "type": ["integer", "null"] },
          "localizations": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/ManualSiteLocalization" }
          }
        }
      },
      "ReviewRequest": {
        "type": "object",
        "properties": { "note": { "type": "string", "maxLength": 500 } }
      },
      "AssetRegisterRequest": {
        "type": "object",
        "required": ["external_id", "storage_key", "public_url", "content_hash", "mime_type", "size_bytes", "width", "height", "album"],
        "properties": {
          "external_id": { "type": "string" },
          "storage_key": { "type": "string" },
          "public_url": { "type": "string", "format": "uri" },
          "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "mime_type": { "type": "string", "pattern": "^image/" },
          "size_bytes": { "type": "integer", "minimum": 1 },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "album": { "type": "string", "const": "6url" }
        }
      },
      "PublishSubmissionRequest": {
        "type": "object",
        "required": ["slug", "localizations"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "logo_asset_id": { "type": ["integer", "null"] },
          "localizations": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "$ref": "#/components/schemas/ManualSiteLocalization" }
          }
        }
      },
      "AdLocalization": {
        "type": "object",
        "required": ["locale", "title", "description", "cta_label", "alt_text"],
        "properties": {
          "locale": { "type": "string", "enum": ["zh-CN", "en", "ja", "ko"] },
          "title": { "type": "string", "maxLength": 180 },
          "description": { "type": "string", "maxLength": 500 },
          "cta_label": { "type": "string", "maxLength": 80 },
          "alt_text": { "type": "string", "maxLength": 300 }
        }
      },
      "PublishAdRequest": {
        "type": "object",
        "required": ["image_asset_id", "localizations"],
        "properties": {
          "image_asset_id": { "type": "integer", "minimum": 1 },
          "sort_order": { "type": "integer", "default": 0 },
          "localizations": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/components/schemas/AdLocalization" } }
        }
      },
      "CommitAdRequest": {
        "type": "object",
        "required": ["status", "sort_order", "version"],
        "properties": {
          "status": { "type": "string", "enum": ["active", "paused", "canceled"] },
          "sort_order": { "type": "integer" },
          "starts_at": { "type": "string", "format": "date-time" },
          "ends_at": { "type": "string", "format": "date-time" },
          "clear_starts_at": { "type": "boolean", "default": false },
          "clear_ends_at": { "type": "boolean", "default": false },
          "version": { "type": "integer", "minimum": 1 }
        }
      },
      "MarkPaidRequest": {
        "type": "object",
        "required": ["external_ref", "note"],
        "properties": { "external_ref": { "type": "string", "maxLength": 255 }, "note": { "type": "string", "maxLength": 500 } }
      },
      "RefundRequest": {
        "type": "object",
        "required": ["reason"],
        "properties": { "reason": { "type": "string", "maxLength": 500 } }
      }
    }
  },
  "security": [{ "adminToken": [] }],
  "paths": {
    "/admin/v1/openapi.json": {
      "get": {
        "operationId": "getAdminOpenAPI",
        "responses": { "200": { "description": "OpenAPI document" } }
      }
    },
    "/admin/v1/me": {
      "get": {
        "operationId": "getAdminIdentity",
        "responses": { "200": { "description": "Current administrator token" } }
      }
    },
    "/admin/v1/overview": {
      "get": {
        "operationId": "getAdminOverview",
        "responses": { "200": { "description": "Operational counts" } }
      }
    },
    "/admin/v1/categories": {
      "get": {
        "operationId": "listCategories",
        "parameters": [{ "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100 } }],
        "responses": { "200": { "description": "Category list" } }
      }
    },
    "/admin/v1/sites": {
      "get": {
        "operationId": "listSites",
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100 } },
          { "name": "status", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Site list" } }
      }
    },
    "/admin/v1/sites/manual": {
      "post": {
        "operationId": "createManualSite",
        "description": "Creates a draft site and a free editorial placement. It does not create a submission or payment order.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ManualSiteRequest" } } }
        },
        "responses": {
          "201": { "description": "Draft site created" },
          "400": { "description": "Invalid request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "409": { "description": "URL or slug conflict", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/admin/v1/submissions": {
      "get": { "operationId": "listSubmissions", "responses": { "200": { "description": "Listing submission queue" } } }
    },
    "/admin/v1/submissions/{id}/preapprove": {
      "post": { "operationId": "preapproveSubmission", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReviewRequest" } } } }, "responses": { "200": { "description": "Preapproved; paid applications receive an order" }, "409": { "description": "Invalid state or unavailable offer" } } }
    },
    "/admin/v1/submissions/{id}/request-changes": {
      "post": { "operationId": "requestSubmissionChanges", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReviewRequest" } } } }, "responses": { "200": { "description": "Changes requested" } } }
    },
    "/admin/v1/submissions/{id}/reject": {
      "post": { "operationId": "rejectSubmission", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReviewRequest" } } } }, "responses": { "200": { "description": "Submission rejected" } } }
    },
    "/admin/v1/submissions/{id}/publish": {
      "post": { "operationId": "publishSubmission", "description": "Atomically publishes four localized revisions, the site, commercial placement, audit log, notification and frontend revalidation job. Exchange submissions run SSRF-safe backlink verification before the transaction.", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PublishSubmissionRequest" } } } }, "responses": { "200": { "description": "Submission published" }, "409": { "description": "Submission or payment state is not publishable" }, "422": { "description": "Exchange backlink verification failed" } } }
    },
    "/admin/v1/ad-applications": {
      "get": { "operationId": "listAdApplications", "responses": { "200": { "description": "Sponsor advertising application queue" } } }
    },
    "/admin/v1/ad-applications/{id}/preapprove": {
      "post": { "operationId": "preapproveAdApplication", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReviewRequest" } } } }, "responses": { "200": { "description": "Preapproved with a sponsor order" } } }
    },
    "/admin/v1/ad-applications/{id}/request-changes": {
      "post": { "operationId": "requestAdApplicationChanges", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReviewRequest" } } } }, "responses": { "200": { "description": "Changes requested" } } }
    },
    "/admin/v1/ad-applications/{id}/reject": {
      "post": { "operationId": "rejectAdApplication", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReviewRequest" } } } }, "responses": { "200": { "description": "Advertising application rejected" } } }
    },
    "/admin/v1/ad-applications/{id}/publish": {
      "post": { "operationId": "publishAdApplication", "description": "Atomically publishes a paid Sponsor ad with four localizations, its paid duration snapshot, audit, notifications and homepage revalidation.", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PublishAdRequest" } } } }, "responses": { "200": { "description": "Sponsor ad published" }, "409": { "description": "Application or paid order is not publishable" } } }
    },
    "/admin/v1/assets/register": {
      "post": { "operationId": "registerImgAntAsset", "description": "Registers metadata for an image already uploaded by local AI to the ImgAnt 6url album.", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AssetRegisterRequest" } } } }, "responses": { "201": { "description": "Asset registered" } } }
    },
    "/admin/v1/ads/manual": {
      "post": { "operationId": "createManualSponsorAd", "description": "Creates a free administrator-owned draft sponsor ad without an application or payment order.", "responses": { "201": { "description": "Draft sponsor ad created" } } }
    },
    "/admin/v1/ads/{id}/commit": {
      "post": { "operationId": "commitAd", "description": "Commits advertisement state, schedule and sort order with optimistic concurrency and homepage revalidation. Omitted schedule fields are preserved; clear flags apply only to administrator-owned ads; advertiser schedules remain fixed by the paid order.", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }, { "name": "If-Match", "in": "header", "required": true, "schema": { "type": "string" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CommitAdRequest" } } } }, "responses": { "200": { "description": "Advertisement committed" }, "409": { "description": "Paid schedule mutation rejected" }, "412": { "description": "Version or ETag mismatch" } } }
    },
    "/admin/v1/placements/{id}/recheck": {
      "post": { "operationId": "recheckExchangePlacement", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Backlink checked and placement health updated" }, "404": { "description": "Exchange placement not found" } } }
    },
    "/admin/v1/ads": {
      "get": { "operationId": "listAds", "responses": { "200": { "description": "Sponsor advertisements" } } }
    },
    "/admin/v1/ads/{id}": {
      "get": { "operationId": "getAd", "description": "Returns an advertisement and all localizations. ETag uses W/\"ad-{id}-v{version}\" and is required by commit.", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Advertisement detail with ETag" }, "404": { "description": "Advertisement not found" } } }
    },
    "/admin/v1/orders": {
      "get": { "operationId": "listOrders", "responses": { "200": { "description": "Payment orders" } } }
    },
    "/admin/v1/orders/{id}/mark-paid": {
      "post": { "operationId": "markManualOrderPaid", "description": "Marks a pending manual order paid and advances its application. Requires payments:write and Idempotency-Key.", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }, { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 8, "maxLength": 255 } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MarkPaidRequest" } } } }, "responses": { "200": { "description": "Manual order marked paid" }, "409": { "description": "Order or application state conflict" } } }
    },
    "/admin/v1/orders/{id}/refund": {
      "post": { "operationId": "refundOrder", "description": "Creates a full Stripe refund. Immediate success revokes the paid placement or Sponsor ad atomically; asynchronous refunds enter refund_pending until refund.updated.", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }, { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 8, "maxLength": 255 } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RefundRequest" } } } }, "responses": { "200": { "description": "Refund succeeded" }, "202": { "description": "Refund pending" }, "409": { "description": "Order is not refundable" }, "502": { "description": "Stripe refund failed" } } }
    }
  }
}
